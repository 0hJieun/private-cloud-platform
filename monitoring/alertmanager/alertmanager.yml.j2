global:
  resolve_timeout: 5m

route:
  # Slack webhook을 아직 넣지 않은 최초 배포에서도 alert rule·UI는 동작한다.
  # secret을 등록하고 playbook을 재실행하면 receiver가 Slack으로 자동 전환된다.
  receiver: "{{ 'slack-private-cloud' if (monitoring_slack_webhook_url | trim | length > 0) else 'discard' }}"
  group_by: [alertname, scope, node, cloud_instance_name]
  group_wait: 15s
  group_interval: 5m
  repeat_interval: 4h

receivers:
  - name: discard
{% if monitoring_slack_webhook_url | trim | length > 0 %}
  - name: slack-private-cloud
    slack_configs:
      - api_url: '{{ monitoring_slack_webhook_url | trim }}'
        send_resolved: true
        title: '{% raw %}{{ .Status | toUpper }}{% endraw %} · Private Cloud'
        text: >-
          {% raw %}{{ range .Alerts }}{% endraw %}
          *{% raw %}{{ .Labels.alertname }}{% endraw %}* — {% raw %}{{ .Annotations.summary }}{% endraw %}
          {% raw %}{{ .Annotations.description }}{% endraw %}
          {% raw %}{{ end }}{% endraw %}
{% endif %}
