global:
  resolve_timeout: 5m

route:
  # Slack webhook을 아직 넣지 않은 최초 배포에서도 alert rule·UI는 동작한다.
  # secret을 등록하고 playbook을 재실행하면 receiver가 Slack으로 자동 전환된다.
  receiver: "{{ 'slack-private-cloud' if (monitoring_slack_webhook_url.stdout | trim | length > 0) else 'discard' }}"
  group_by: [alertname, scope, node, cloud_instance_name]
  group_wait: 15s
  # 최초 장애는 `for` 조건을 통과한 뒤 group_wait만큼 모아 전달한다.
  # 복구/상태 변경까지 5분씩 지연되면 소규모 운영 화면과 맞지 않으므로 1분으로 둔다.
  group_interval: 1m
  repeat_interval: 4h

receivers:
  - name: discard
{% if monitoring_slack_webhook_url.stdout | trim | length > 0 %}
  - name: slack-private-cloud
    slack_configs:
      # to_json은 URL을 YAML string으로 안전하게 escaping한다. secret에 예상하지 못한
      # quote가 있어도 YAML 구조가 깨지지 않으며, 형식 검증 task가 URL 자체를 거절한다.
      - api_url: {{ monitoring_slack_webhook_url.stdout | trim | to_json }}
        send_resolved: true
        title: '{% raw %}{{ if eq .Status "firing" }}🚨 장애 감지{{ else }}✅ 복구 완료{{ end }}{% endraw %} · Private Cloud'
        # 제목과 본문의 Grafana 링크는 알림 종류에 맞는 운영 화면으로 연결한다.
        # VM 이름은 생성 시 소문자·숫자·하이픈만 허용하므로 URL query로 안전하게 사용한다.
        title_link: '{% raw %}{{ if .CommonLabels.cloud_instance_name }}http://172.16.2.10:3000/d/private-cloud-instances?var-instance={{ .CommonLabels.cloud_instance_name }}{{ else }}http://172.16.2.10:3000/d/private-cloud-nodes{{ end }}{% endraw %}'
        # YAML double-quoted scalar의 \n escape는 Alertmanager에 실제 newline으로 전달된다.
        # Jinja block whitespace 처리에 의존하지 않아 Slack mrkdwn의 줄 구조가 유지된다.
        text: "{% raw %}{{ range .Alerts }}{% endraw %}*알림* `{% raw %}{{ .Labels.alertname }}{% endraw %}`\n*대상* {% raw %}{{ .Labels.node }}{% endraw %}{% raw %}{{ with .Labels.cloud_instance_name }} / {{ . }}{% endraw %}{% raw %}{{ end }}{% endraw %}\n*상태* {% raw %}{{ if eq .Status \"firing\" }}발생{{ else }}복구{{ end }}{% endraw %}\n*요약* {% raw %}{{ .Annotations.summary }}{% endraw %}\n{% raw %}{{ .Annotations.description }}{% endraw %}\n*대시보드* {% raw %}{{ if .Labels.cloud_instance_name }}<http://172.16.2.10:3000/d/private-cloud-instances?var-instance={{ .Labels.cloud_instance_name }}|VM 대시보드 열기>{{ else }}<http://172.16.2.10:3000/d/private-cloud-nodes|노드 대시보드 열기>{{ end }}{% endraw %}\n---\n{% raw %}{{ end }}{% endraw %}"
{% endif %}
