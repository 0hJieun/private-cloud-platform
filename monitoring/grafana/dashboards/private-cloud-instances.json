{
  "annotations": { "list": [] },
  "editable": true,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] } }, "overrides": [] },
      "gridPos": { "h": 7, "w": 4, "x": 0, "y": 0 },
      "id": 1,
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [{ "expr": "sum(up{job=\"instance\",cloud_instance_name=~\"$instance\"})", "refId": "A" }],
      "title": "정상 수집 VM",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } }, "overrides": [] },
      "gridPos": { "h": 7, "w": 4, "x": 4, "y": 0 },
      "id": 7,
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [{ "expr": "count(up{job=\"instance\",cloud_instance_name=~\"$instance\"} == 0)", "refId": "A" }],
      "title": "장애 VM 수",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "custom": { "align": "left", "cellOptions": { "type": "auto" } } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "상태" },
            "properties": [
              { "id": "mappings", "value": [{ "options": { "0": { "color": "red", "index": 0, "text": "DOWN" }, "1": { "color": "green", "index": 1, "text": "UP" } }, "type": "value" }] },
              { "id": "color", "value": { "mode": "thresholds" } },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] } },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } }
            ]
          }
        ]
      },
      "gridPos": { "h": 7, "w": 16, "x": 8, "y": 0 },
      "id": 6,
      "options": { "cellHeight": "sm", "showHeader": true },
      "targets": [{ "expr": "up{job=\"instance\",cloud_instance_name=~\"$instance\"}", "format": "table", "instant": true, "refId": "A" }],
      "title": "관리 VM exporter 수집 상태",
      "transformations": [{ "id": "organize", "options": { "excludeByName": { "Time": true, "__name__": true, "job": true, "role": true }, "indexByName": { "cloud_instance_name": 0, "instance": 1, "Value": 2 }, "renameByName": { "cloud_instance_name": "VM 이름", "instance": "수집 대상", "Value": "상태" } } }],
      "type": "table"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent" }, "overrides": [] },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 7 },
      "id": 2,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "none" } },
      "targets": [{ "expr": "100 * (1 - avg by(cloud_instance_name) (rate(node_cpu_seconds_total{job=\"instance\",cloud_instance_name=~\"$instance\",mode=\"idle\"}[$__rate_interval])))", "legendFormat": "{{cloud_instance_name}}", "refId": "A" }],
      "title": "VM CPU 사용률",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent" }, "overrides": [] },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 7 },
      "id": 3,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "none" } },
      "targets": [{ "expr": "100 * (1 - node_memory_MemAvailable_bytes{job=\"instance\",cloud_instance_name=~\"$instance\"} / node_memory_MemTotal_bytes{job=\"instance\",cloud_instance_name=~\"$instance\"})", "legendFormat": "{{cloud_instance_name}}", "refId": "A" }],
      "title": "VM 메모리 사용률",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent" }, "overrides": [] },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 16 },
      "id": 4,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "none" } },
      "targets": [{ "expr": "100 * (1 - node_filesystem_avail_bytes{job=\"instance\",cloud_instance_name=~\"$instance\",mountpoint=\"/\",fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{job=\"instance\",cloud_instance_name=~\"$instance\",mountpoint=\"/\",fstype!~\"tmpfs|overlay\"})", "legendFormat": "{{cloud_instance_name}}", "refId": "A" }],
      "title": "VM 루트 디스크 사용률",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 16 },
      "id": 5,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "none" } },
      "targets": [
        { "expr": "sum by(cloud_instance_name) (rate(node_network_receive_bytes_total{job=\"instance\",cloud_instance_name=~\"$instance\",device!~\"lo\"}[$__rate_interval]))", "legendFormat": "{{cloud_instance_name}} receive", "refId": "A" },
        { "expr": "sum by(cloud_instance_name) (rate(node_network_transmit_bytes_total{job=\"instance\",cloud_instance_name=~\"$instance\",device!~\"lo\"}[$__rate_interval]))", "legendFormat": "{{cloud_instance_name}} transmit", "refId": "B" }
      ],
      "title": "VM 네트워크 처리량",
      "type": "timeseries"
    }
  ],
  "schemaVersion": 39,
  "tags": ["private-cloud", "instances", "admin"],
  "templating": {
    "list": [
      {
        "allValue": ".*",
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "query_result(up{job=\"instance\"})",
        "includeAll": true,
        "label": "VM 선택",
        "multi": true,
        "name": "instance",
        "options": [],
        "query": { "query": "query_result(up{job=\"instance\"})", "refId": "PrometheusVariableQueryEditor-VariableQuery" },
        "refresh": 1,
        "regex": "/cloud_instance_name=\"([^\"]+)\"/",
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "title": "Private Cloud Instance Operations",
  "uid": "private-cloud-instances",
  "version": 3
}
