      "targets": [{ "expr": "sum by(node) (rate(node_network_receive_bytes_total{job=\"node\",device!~\"lo|virbr.*\"}[5m]) + rate(node_network_transmit_bytes_total{job=\"node\",device!~\"lo|virbr.*\"}[5m]))", "legendFormat": "{{node}}", "refId": "A" }],
      "title": "노드 네트워크 처리량",
