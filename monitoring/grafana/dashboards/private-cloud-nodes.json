      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "none" } },
      "targets": [{ "expr": "node_memory_MemAvailable_bytes{job=\"node\"} / 1024 / 1024", "legendFormat": "{{node}}", "refId": "A" }],
      "title": "가용 메모리",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent" }, "overrides": [] },
