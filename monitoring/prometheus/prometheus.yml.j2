global:
  # 소규모 실습의 장애 시연: 10초마다 수집·판정하고, 느린 응답은 5초까지만 기다린다.
  scrape_interval: 10s
  scrape_timeout: 5s
  evaluation_interval: 10s

# Prometheus는 규칙을 평가만 한다. deduplication·silence·Slack 같은 알림 전달은
# loopback Alertmanager가 담당한다.
alerting:
  alertmanagers:
    - static_configs:
        - targets: ['127.0.0.1:9093']

rule_files:
  - /etc/prometheus/rules/*.yml

scrape_configs:
  - job_name: node
    static_configs:
{% for host in groups['monitoring_nodes'] | sort %}
      - targets: ['{{ hostvars[host].monitoring_bind_address }}:9100']
        labels:
          node: '{{ host }}'
          role: '{{ hostvars[host].monitoring_role }}'
{% endfor %}

  # instance target은 고정 YAML에 손으로 추가하지 않는다. portal API가 ACTIVE 상태이면서
  # monitoring_enabled=true인 VM만 DB에서 골라 반환하고 Prometheus가 30초마다 갱신한다.
  - job_name: instance
    http_sd_configs:
      - url: http://127.0.0.1:8000/internal/prometheus/instance-targets
        refresh_interval: 30s
        authorization:
          type: Bearer
          # Ansible register 결과 전체가 아니라 shell task가 읽은 실제 token 문자열만 쓴다.
          # 결과 객체를 렌더하면 내부 작은따옴표 때문에 Prometheus YAML 자체가 깨진다.
          credentials: '{{ monitoring_instance_discovery_token.stdout }}'
